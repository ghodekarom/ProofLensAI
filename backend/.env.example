# ==========================================
# ProofLens AI - Backend Environment Configuration Template
# ==========================================

APP_ENV=development
APP_NAME=ProofLens AI
DEBUG=false
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# Database Connection (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+psycopg://prooflens:prooflens_local_only@localhost:5432/prooflens
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Local File Storage
FILE_STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/uploads
MAX_UPLOAD_BYTES=20971520
MAX_BATCH_FILES=10
MAX_PDF_PAGES=500

# Chunking & Retrieval
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
RETRIEVAL_TOP_K_DEFAULT=5
RETRIEVAL_TOP_K_MAX=20
RETRIEVAL_DISTANCE_THRESHOLD=

# AI Provider Configuration (Google Gemini API)
LLM_PROVIDER=google_gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2048

EMBEDDING_PROVIDER=google_gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

GEMINI_API_KEY=replace_with_your_gemini_api_key

# Security & CORS
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_FORMAT=json
